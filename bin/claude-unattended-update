#!/bin/bash
# Roll a Claude Code update out one session at a time, restarting each session
# only once it is genuinely idle.
#
#   1. cheap version check (exits immediately when there is nothing new)
#   2. install the new version and wait for it to land completely
#   3. find sessions still running the old binary
#   4. per session: wait for idle, stop it, resume it, carry its pin across
#
# Doing all four in one engine is the point: nothing else is swapping the
# binary while a restart is in flight.
#
# Two CLI behaviours drive the awkward parts:
#
#   * The daemon supervisor watches claude.exe's mtime and re-execs when it
#     changes. Firing mid-install yields "self-respawn failed: EACCES" and the
#     orphan watchdog reaps every worker 60s later, so step 2 confirms the
#     supervisor survived and restarts it if it did not.
#   * Resuming a session mints a NEW job id and a NEW session id, and writes no
#     transcript for the new id until that session next receives a prompt. A pin
#     left on the old job id points at a dead job; step 4 moves it. --repair
#     fixes pins that already went stale this way.
#
# Usage: claude-unattended-update [--dry-run] [--force] [--repair] [--forget <job-id>]

set -uo pipefail

PKG=@anthropic-ai/claude-code
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
LOG="${UPDATER_LOG:-$CLAUDE_DIR/unattended-update.log}"
STATE="$CLAUDE_DIR/unattended-update-state.json"
INHIBIT="$CLAUDE_DIR/no-auto-update"
JOBS="$CLAUDE_DIR/jobs"
PROJECTS="$CLAUDE_DIR/projects"

POLL="${UPDATER_POLL:-60}"                 # seconds between idle polls
IDLE_STREAK="${UPDATER_IDLE_STREAK:-2}"    # consecutive idle polls before restarting
DEADLINE="${UPDATER_DEADLINE:-$((6*60*60))}"       # per session
INSTALL_TIMEOUT="${UPDATER_INSTALL_TIMEOUT:-900}"
PASS_DEADLINE="${UPDATER_PASS_DEADLINE:-$((12*60*60))}"  # whole pass
CLAUDE_TIMEOUT="${UPDATER_CLAUDE_TIMEOUT:-120}"
MAX_RETRIES="${UPDATER_MAX_RETRIES:-3}"

DRY=0; FORCE=0; REPAIR_ONLY=0; FORGET_NEXT=0; FORGET_ID=""
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --force)   FORCE=1 ;;
    --repair)  REPAIR_ONLY=1 ;;
    --forget)  FORGET_NEXT=1 ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) if [ "$FORGET_NEXT" -eq 1 ]; then FORGET_ID="$a"; FORGET_NEXT=0
       else echo "unknown option: $a" >&2; exit 2; fi ;;
  esac
done

WORKFILE="$(mktemp)"; FLAGFILE="$(mktemp)"; STALEFILE="$(mktemp)"
trap 'rm -f "$WORKFILE" "$FLAGFILE" "$STALEFILE"' EXIT

log() { printf '[%s] %s\n' "$(date -Is)" "$*" >>"$LOG"; }
say() { log "$*"; printf '%s\n' "$*"; return 0; }

# nvm installs are common and put claude outside a login shell's PATH.
[ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ] && . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1
CLAUDE="${CLAUDE_BIN:-$(command -v claude 2>/dev/null)}"
[ -z "$CLAUDE" ] && { say "claude not found on PATH; set CLAUDE_BIN"; exit 1; }
# The wrapper is a symlink into the package; the supervisor watches the real file.
EXE="$(readlink -f "$CLAUDE" 2>/dev/null || echo "$CLAUDE")"

# A wedged daemon makes these calls hang forever; the unit has no timeout of
# its own, and while it runs the hourly timer is suppressed.
run_claude() { DISABLE_AUTOUPDATER=1 timeout "$CLAUDE_TIMEOUT" "$CLAUDE" "$@"; }

installed_version() { run_claude --version 2>/dev/null | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+'; }

latest_version() {
  if command -v curl >/dev/null; then
    curl -sSfL "https://registry.npmjs.org/$PKG/latest" 2>/dev/null |
      python3 -c 'import json,sys;print(json.load(sys.stdin).get("version",""))' 2>/dev/null && return
  fi
  command -v npm >/dev/null && npm view "$PKG" version 2>/dev/null | tr -d '[:space:]'
}

# A session list that fails to parse must not read as "nothing to do"; every
# caller treats an empty list as a completed rollout.
agents_json() {
  local out
  out="$(run_claude agents --json 2>/dev/null)" || return 1
  printf '%s' "$out" | python3 -c 'import json,sys;d=json.load(sys.stdin);sys.exit(0 if isinstance(d,list) else 1)' 2>/dev/null || return 1
  printf '%s' "$out"
}

PY_STALE='
import json,sys
cut=float(sys.argv[1])
try: d=json.load(sys.stdin)
except Exception: raise SystemExit
for s in d:
    if s.get("kind")!="background": continue
    ts=s.get("startedAt")
    started=float(ts)/1000.0 if isinstance(ts,(int,float)) else None
    if started is None:
        print("unparsable startedAt for "+str(s.get("id")),file=sys.stderr)
        sys.exit(1)
    if started<cut:
        sys.stdout.write("\x1f".join([str(s.get("id")),str(s.get("sessionId")),str(s.get("cwd")),str(s.get("name"))])+"\0")
'
# Prints a live job that accounts for $1 — the job itself if it never stopped,
# or the one we resumed from it. Fails when the session list cannot be read, so
# callers do not mistake that for "nothing is running".
find_live_for() {
  local listing
  listing="$(agents_json </dev/null)" || return 2
  printf '%s' "$listing" | python3 -c '
import json, os, sys
jobs, old = sys.argv[1], sys.argv[2]
for x in json.load(sys.stdin):
    ident = str(x.get("id"))
    if ident == old:
        print(ident); break
    marker = os.path.join(jobs, ident, ".updater-pin-source")
    try:
        if open(marker).read().strip() == old:
            print(ident); break
    except OSError:
        pass
' "$JOBS" "$1"
}

PY_FIND_NEW='
import json, sys
# A background job present now and absent before the resume is the one the
# resume minted. Comparing wall-clock start times instead would reject a session
# the daemon stamped a moment early.
before = set(sys.argv[1].split())
cwd = sys.argv[2]
try: d = json.load(sys.stdin)
except Exception: raise SystemExit
fresh = [str(x.get("id")) for x in d
         if x.get("kind") == "background"
         and str(x.get("id")) not in before
         and x.get("cwd") == cwd]
# Exactly one new job in this directory is an identification; more than one is a
# guess, and guessing moves a pin onto an unrelated conversation.
if len(fresh) == 1:
    print(fresh[0])
'
PY_STATE='
import json, os, sys, tempfile

path, action = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
d.setdefault("pending", [])
d.setdefault("failed", [])

if action == "record":
    ident, sid, cwd, name = sys.argv[3:7]
    flags = []
    try:
        flags = json.load(open(os.path.join(os.path.dirname(path), "jobs", ident,
                                            "state.json"))).get("respawnFlags") or []
    except Exception:
        pass
    d["failed"] = [f for f in d["failed"] if f.get("id") != ident]
    d["failed"].append({"id": ident, "sessionId": sid, "cwd": cwd,
                        "name": name, "respawnFlags": flags})
elif action == "count-failed":
    print(len(d["failed"])); raise SystemExit
elif action == "count-attempts":
    for f in d["failed"]:
        if f.get("id") == sys.argv[3]:
            print(int(f.get("attempts") or 0)); break
    else:
        print(0)
    raise SystemExit
elif action == "attempt":
    for f in d["failed"]:
        if f.get("id") == sys.argv[3]:
            f["attempts"] = int(f.get("attempts") or 0) + 1
            print(f["attempts"])
            break
    else:
        raise SystemExit
elif action == "drop":
    kept = [f for f in d["failed"] if f.get("id") != sys.argv[3]]
    print("dropped" if len(kept) != len(d["failed"]) else "absent")
    d["failed"] = kept
elif action == "pending":
    d["rolloutVersion"] = sys.argv[3]
    d["pending"] = sys.argv[4:]
elif action == "read":
    for f in d["failed"]:
        print("\x1f".join([f.get("id",""), f.get("sessionId",""),
                           f.get("cwd",""), f.get("name","")]))
    raise SystemExit
elif action == "flags":
    for f in d["failed"]:
        if f.get("id") == sys.argv[3]:
            sys.stdout.write("\0".join(
                x for x in (f.get("respawnFlags") or []) if x != "--reply-on-resume"))
            break
    raise SystemExit
elif action == "count":
    print(len(d["pending"]) + len(d["failed"])); raise SystemExit

if not d["pending"] and not d["failed"]:
    if os.path.exists(path):
        os.unlink(path)
    raise SystemExit
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".state.")
with os.fdopen(fd, "w") as fh:
    json.dump(d, fh, indent=2)
    fh.flush(); os.fsync(fh.fileno())
os.replace(tmp, path)
'
PY_MOVE_PIN='
import json, os, shutil, sys, tempfile
JOBS, old, new = sys.argv[1], sys.argv[2], sys.argv[3]
p = os.path.join(JOBS, "pins.json")
marker = os.path.join(JOBS, new, ".updater-pin-source")
# Written even when the job was not pinned, so --repair can always tell a
# resumed session from a pin orphaned by a reaped respawn. Never overwrite one:
# a marker that already names a different job belongs to that job.
if not os.path.exists(marker):
    with open(marker, "w") as fh:
        fh.write(old + "\n")
try: pins = json.load(open(p))
except Exception: raise SystemExit
if old not in pins: raise SystemExit
pins[pins.index(old)] = new
fd, tmp = tempfile.mkstemp(dir=JOBS, prefix=".pins.")
with os.fdopen(fd, "w") as fh:
    json.dump(pins, fh, indent=2)
    fh.flush(); os.fsync(fh.fileno())
os.replace(tmp, p)
src, dst = os.path.join(JOBS, old, "order"), os.path.join(JOBS, new, "order")
if os.path.exists(src) and not os.path.exists(dst):
    try:
        shutil.move(src, dst)
    except OSError as e:
        print(f"    pin moved but order file left behind: {e}", file=sys.stderr)
print(f"    pin moved {old} -> {new}")
'
PY_FLAGS='
import json, sys
d = json.load(open(sys.argv[1]))
flags = [f for f in (d.get("respawnFlags") or []) if f != "--reply-on-resume"]
if not flags:
    sys.exit(1)
sys.stdout.write("\0".join(flags))
'
PY_STATUS='
import json,sys
d=json.load(sys.stdin)
m=[s for s in d if s.get("id")==sys.argv[1]]
print(m[0].get("status") if m else "gone")
'

# `claude agents` owns the supervisor; a headless --json call spawns a transient
# one and needs no TTY. Set UPDATER_TMUX_SOCKET to keep it in a tmux session.
restart_daemon() {
  if [ -n "${UPDATER_TMUX_SOCKET:-}" ]; then
    tmux -L "$UPDATER_TMUX_SOCKET" kill-server 2>/dev/null || true
    ( DISABLE_AUTOUPDATER=1 tmux -L "$UPDATER_TMUX_SOCKET" \
        new-session -d -s "${UPDATER_TMUX_SESSION:-daemon}" "exec \"$CLAUDE\" agents" )
  else
    DISABLE_AUTOUPDATER=1 run_claude agents --json >/dev/null 2>&1 </dev/null || true
  fi
}

supervisor_alive() {
  python3 - "$CLAUDE_DIR/daemon.lock" <<'PY' 2>/dev/null
import json, os, sys
try:
    lock = json.load(open(sys.argv[1]))
    pid = lock["pid"]
except Exception:
    sys.exit(1)
try:
    stat = open(f"/proc/{pid}/stat").read()
except OSError:
    sys.exit(1)
want = lock.get("procStart")
if want:
    # Field 22 of /proc/pid/stat is starttime; comm can contain spaces and
    # parentheses, so count fields after the final ')'.
    fields = stat[stat.rfind(")") + 2:].split()
    if fields[19] != str(want):
        sys.exit(1)
sys.exit(0)
PY
}

repair_pins() {
  # A session resumed by a rollout has no transcript until its next prompt,
  # which is indistinguishable from a phantom pin on disk alone. Liveness tells
  # them apart, so without a readable session list this refuses to act.
  local live
  live="$(agents_json | python3 -c 'import json,sys;print(" ".join(str(s.get("id"))+":"+str(s.get("startedAt")) for s in json.load(sys.stdin)))' 2>/dev/null)" \
    || { say "  cannot read the session list; refusing to repair"; return 1; }
  python3 - "$JOBS" "$PROJECTS" "${1:-report}" "$live" "${2:-all}" <<'PY'
import json, glob, os, shutil, sys, tempfile
JOBS, PROJ, mode = sys.argv[1], sys.argv[2], sys.argv[3]
scope = sys.argv[5] if len(sys.argv) > 5 else "all"
# id -> start time of the process the daemon currently has for that job.
live = {}
for item in (sys.argv[4] if len(sys.argv) > 4 else "").split():
    ident, _, started = item.partition(":")
    live[ident] = started
pins_path = os.path.join(JOBS, "pins.json")
try:
    pins = json.load(open(pins_path))
except Exception as e:
    if isinstance(e, FileNotFoundError):
        print("  no pins.json; nothing to repair"); raise SystemExit
    print(f"  cannot read pins.json: {e}"); sys.exit(1)

def load(j):
    try: return json.load(open(os.path.join(JOBS, j, "state.json")))
    except Exception: return None

def write_pins(pins):
    # Truncating pins.json in place risks losing every pin if the write is cut
    # short, so swap it atomically.
    fd, tmp = tempfile.mkstemp(dir=JOBS, prefix=".pins.")
    with os.fdopen(fd, "w") as fh:
        json.dump(pins, fh, indent=2)
        fh.flush(); os.fsync(fh.fileno())
    os.replace(tmp, pins_path)

def transcript_for(sid):
    return glob.glob(os.path.join(PROJ, "*", f"{sid}.jsonl")) if sid else []

changed = found = unrepaired = False
# A pin restored to its source may itself be a resumed job that was never
# prompted, so each replacement is re-examined rather than left for a second run.
queue, seen = list(pins), set()
while queue:
    job = queue.pop(0)
    if job in seen:
        continue
    seen.add(job)
    d = load(job)
    if not d:
        found = unrepaired = True
        print(f"  {job}: no state.json — leaving alone"); continue
    sid = d.get("resumeSessionId") or d.get("sessionId")
    if transcript_for(sid):
        continue
    marker = os.path.join(JOBS, job, ".updater-pin-source")
    src, started_at = "", ""
    if os.path.exists(marker):
        lines = open(marker).read().split("\n")
        src = lines[0].strip()
        for ln in lines[1:]:
            if ln.startswith("startedAt="):
                started_at = ln.split("=", 1)[1].strip()
    if job in live and started_at and live[job] == started_at:
        # Still the process we resumed: its transcript appears when prompted.
        continue
    if job in live and not started_at and not src:
        # Nothing records that this tool resumed it, so leave it alone.
        continue
    found = True
    if src:
        if os.path.isdir(os.path.join(JOBS, src)) and src not in pins:
            why = ("was respawned, losing what it held"
                   if job in live else "never started again")
            print(f'  {job}: resumed from {src}, never prompted, and {why}; restoring that pin')
            if mode != "apply":
                unrepaired = True
            if mode == "apply":
                pins[pins.index(job)] = src
                write_pins(pins)
                o_src, o_dst = os.path.join(JOBS, job, "order"), os.path.join(JOBS, src, "order")
                if os.path.exists(o_src) and not os.path.exists(o_dst):
                    shutil.move(o_src, o_dst)
                changed = True
                queue.append(src)
            continue
    if scope != "all":
        continue
    name, cwd = d.get("name"), d.get("cwd")
    print(f'  {job} ("{name}"): session {sid} has no transcript')
    # A job dir is named for the first 8 chars of its session id, so the owner
    # of a conversation is a job with the same name AND the same cwd whose
    # transcript exists. Name alone is not an identity: respawnFlags carry
    # --name, so unrelated sessions routinely share one.
    cands = []
    for other in os.listdir(JOBS):
        if other == job or not os.path.isdir(os.path.join(JOBS, other)):
            continue
        od = load(other)
        if not od or od.get("name") != name or od.get("cwd") != cwd:
            continue
        if other in pins:
            continue
        osid = od.get("resumeSessionId") or od.get("sessionId")
        hits = transcript_for(osid)
        if hits:
            cands.append((other, osid, os.path.getsize(hits[0]), os.path.getmtime(hits[0])))
    if not cands:
        print("    no replacement found — needs a human"); unrepaired = True; continue
    cands.sort(key=lambda c: c[3], reverse=True)
    if len(cands) > 1 and cands[0][3] - cands[1][3] < 60:
        names = ", ".join(sorted(c[0] for c in cands))
        print(f"    ambiguous: {names} were active within a minute — refusing to guess")
        unrepaired = True; continue
    other, osid, size, _ = cands[0]
    print(f"    -> best guess: job {other} owns {osid} ({size/1e6:.1f}MB)")
    if mode != "apply":
        unrepaired = True
        continue
    pins[pins.index(job)] = other
    write_pins(pins)
    src, dst = os.path.join(JOBS, job, "order"), os.path.join(JOBS, other, "order")
    if os.path.exists(src) and not os.path.exists(dst):
        shutil.move(src, dst)
    print(f"    repinned {job} -> {other}")
    changed = True
    queue.append(other)
if changed:
    print("  repinned at least one job")
elif found:
    print("  phantom pins found but not repaired")
elif not unrepaired:
    print("  no phantom pins found")
# A pin still pointing at nothing is the only machine-readable signal --repair has.
sys.exit(1 if unrepaired else 0)
PY
}

if ! exec 9>"$CLAUDE_DIR/.unattended-update.lock"; then
  say "cannot open the lock file under $CLAUDE_DIR"; exit 1
fi
if ! flock -n 9; then
  say "another run holds the lock; exiting"
  [ "$REPAIR_ONLY" -eq 1 ] && exit 1
  exit 0
fi

if [ "$FORGET_NEXT" -eq 1 ]; then
  echo "--forget needs a job id" >&2; exit 2
fi
if [ -n "$FORGET_ID" ]; then
  if [ "$(python3 -c "$PY_STATE" "$STATE" drop "$FORGET_ID")" = dropped ]; then
    say "forgot the failure record for $FORGET_ID"
    exit 0
  fi
  say "no failure record for $FORGET_ID"; exit 1
fi

if [ "$REPAIR_ONLY" -eq 1 ]; then
  say "repairing phantom pins..."
  repair_pins "$([ "$DRY" -eq 1 ] && echo report || echo apply)" all | tee -a "$LOG"
  exit $?
fi

[ -e "$INHIBIT" ] && [ "$DRY" -eq 0 ] && { say "inhibited by $INHIBIT"; exit 0; }
[ -e "$INHIBIT" ] && say "note: $INHIBIT is present; this is a dry run so it reports anyway"



# A session with no replayable flags, no directory, or no session id cannot be
# brought back as it was, and resuming into the wrong directory silently
# reroutes every relative path the agent uses.
restart_possible() {
  local id="$1" cwd="$2" name="$3"  # $4 = session id
  if ! python3 -c "$PY_FLAGS" "$JOBS/$id/state.json" >/dev/null 2>>"$LOG"; then
    say "    no usable respawnFlags in $JOBS/$id/state.json; leaving $name alone"
    return 1
  fi
  if [ ! -d "$cwd" ]; then
    say "    $cwd no longer exists; leaving $name alone"
    return 1
  fi
  case "${4:-}" in
    ""|None|null) say "    no session id for $name; leaving it alone"; return 1 ;;
  esac
  return 0
}

# Resume $sid, replaying the job's respawnFlags, and carry the pin to the job
# id the resume mints. Prints nothing on success beyond the new id.
resume_session() {
  local id="$1" sid="$2" cwd="$3" name="$4" out newid
  local -a flags=()
  if [ -n "${5:-}" ] && [ -s "$5" ]; then
    mapfile -d '' -t flags < "$5"
  else
    python3 -c "$PY_FLAGS" "$JOBS/$id/state.json" > "$WORKFILE" 2>>"$LOG" || return 1
    mapfile -d '' -t flags < "$WORKFILE"
  fi
  [ "${#flags[@]}" -gt 0 ] || return 1
  local before before_ok=1
  before="$(agents_json </dev/null | python3 -c 'import json,sys;print(" ".join(str(x.get("id")) for x in json.load(sys.stdin)))' 2>/dev/null)" || before_ok=0
  out="$(cd "$cwd" || exit 1; \
         DISABLE_AUTOUPDATER=1 timeout "$INSTALL_TIMEOUT" \
           "$CLAUDE" --background --resume "$sid" "${flags[@]}" 2>&1 </dev/null)"
  newid="$(printf '%s' "$out" | sed 's/\x1b\[[0-9;]*m//g' \
           | awk '/backgrounded/{for(i=1;i<=NF;i++) if ($i ~ /^[0-9a-f]{8}$/) {print $i; exit}}')"
  if [ -z "$newid" ] || [ ! -d "$JOBS/$newid" ]; then
    # Failing to read the announcement is not evidence that no session started,
    # and recording a live session as failed makes the retry fork a second copy.
    if [ "$before_ok" -eq 1 ]; then
      newid="$(agents_json </dev/null | python3 -c "$PY_FIND_NEW" "$before" "$cwd")"
    fi
  fi
  if [ -z "$newid" ] || [ ! -d "$JOBS/$newid" ]; then
    printf '%s\n' "$out" >>"$LOG"
    return 1
  fi
  say "    resumed as $newid"
  python3 -c "$PY_MOVE_PIN" "$JOBS" "$id" "$newid" >>"$LOG" 2>&1 \
    || say "    WARNING: $name resumed as $newid but its pin could not be moved; see $LOG"
  return 0
}

# Sessions an earlier pass stopped but could not bring back are not in the live
# list, so nothing else rediscovers them.
retry_failed() {
  [ "$DRY" -eq 1 ] && return 0
  [ -r "$STATE" ] || return 0
  local rows id sid cwd name
  rows="$(python3 -c "$PY_STATE" "$STATE" read)" || return 0
  [ -z "$rows" ] && return 0
  while IFS=$'\x1f' read -r id sid cwd name; do
    [ -z "${sid:-}" ] && continue
    live_id="$(find_live_for "$id")"; rc=$?
    if [ "$rc" -ne 0 ]; then
      say "  cannot read the session list; leaving $name recorded"
      continue
    fi
    if [ -n "$live_id" ]; then
      # A pass killed between the resume and dropping the record would
      # otherwise fork a second agent on the same conversation.
      say "  $name is accounted for by live job $live_id; clearing its record"
      python3 -c "$PY_STATE" "$STATE" drop "$id" >/dev/null
      continue
    fi
    tries="$(python3 -c "$PY_STATE" "$STATE" count-attempts "$id")"
    if [ "${tries:-0}" -ge "$MAX_RETRIES" ]; then
      say "  $name has failed to resume $MAX_RETRIES times; not retrying"
      say "    clear it with: claude-unattended-update --forget $id"
      continue
    fi
    tries="$(python3 -c "$PY_STATE" "$STATE" attempt "$id")"
    say "retrying $name, stopped by an earlier pass and never resumed (attempt $tries)"
    python3 -c "$PY_STATE" "$STATE" flags "$id" > "$FLAGFILE" 2>/dev/null
    resume_session "$id" "$sid" "$cwd" "$name" "$FLAGFILE"; rrc=$?
    if [ "$rrc" -eq 2 ]; then
      say "  $name came back but could not be identified; clearing its record"
      python3 -c "$PY_STATE" "$STATE" drop "$id" >/dev/null
      continue
    fi
    if [ "$rrc" -eq 0 ]; then
      # Dropped immediately: a later exit path may never rewrite the state file,
      # and a record left behind forks another live copy every hour.
      python3 -c "$PY_STATE" "$STATE" drop "$id" >/dev/null
      say "  recovered $name"
    else
      say "  still cannot resume $name; it stays recorded"
    fi
  done <<< "$rows"
}
pass_start=$SECONDS
if [ "$DRY" -eq 0 ]; then
  # Markers only: the candidate search guesses from name and cwd, which is fine
  # under a human running --repair and not fine running unattended every hour.
  repair_pins apply markers >>"$LOG" 2>&1 || true
fi

have="$(installed_version)"
if [ -z "$have" ]; then
  say "cannot read the installed version; not installing anything"; exit 1
fi
want="$(latest_version)"
if [ -z "$want" ]; then
  if command -v curl >/dev/null || command -v npm >/dev/null; then
    say "could not reach the registry; retrying next tick"; exit 0
  fi
  say "neither curl nor npm is present; this host cannot check for updates"; exit 1
fi

if [ "$have" != "$want" ] && [ "$FORCE" -eq 0 ] \
   && [ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | tail -1)" = "$have" ]; then
  log "installed $have is newer than the registry's $want; nothing to do"
  want="$have"
fi
if [ "$have" = "$want" ] && [ "$FORCE" -eq 0 ]; then
  outstanding="$(python3 -c "$PY_STATE" "$STATE" count 2>/dev/null)"
  if [ "${outstanding:-0}" -eq 0 ]; then
    [ "$DRY" -eq 1 ] && say "up to date ($have); nothing outstanding"
    log "up to date ($have); nothing outstanding"; exit 0
  fi
  say "up to date ($have) with $outstanding session(s) outstanding"
else
  [ "$have" = "$want" ] && say "forced: re-checking rollout at $have" || say "update available: $have -> $want"
  if [ "$DRY" -eq 1 ]; then
    say "DRY RUN: would install $want now"
  else
    say "installing $want ..."
    env -u DISABLE_AUTOUPDATER timeout "$INSTALL_TIMEOUT" "$CLAUDE" update >>"$LOG" 2>&1 </dev/null \
      || say "installer exited non-zero; see $LOG"
    got="$(installed_version)"
    if [ "$got" != "$want" ]; then
      # Restarting sessions onto a version that was never installed would cost
      # the interruption and deliver nothing.
      say "install did not take: wanted $want, have ${got:-unknown} — see $LOG"; exit 1
    fi
    say "installed $got"
    # The wrapper can point into a per-version directory, so a path resolved
    # before the install may still name the previous version.
    EXE="$(readlink -f "$CLAUDE" 2>/dev/null || echo "$CLAUDE")"
    ok=0
    if [ ! -e "$CLAUDE_DIR/daemon.lock" ]; then
      ok=2
    else
      for _ in $(seq 1 60); do
        if supervisor_alive; then ok=1; break; fi
        sleep 1
      done
    fi
    if [ "$ok" -eq 1 ]; then
      say "supervisor healthy"
    else
      if [ "$ok" -eq 2 ]; then
        say "no agent daemon has run on this host; not starting one"
      else
      say "supervisor lost the EACCES race — restarting it"
      restart_daemon; sleep 15
      if ! supervisor_alive; then
        say "supervisor did not come back; not touching any session"; exit 1
      fi
      say "supervisor restarted"
      fi
    fi
  fi
fi


[ "$DRY" -eq 0 ] && retry_failed

new_version="$(installed_version)"
if ! bin_mtime="$(stat -c %Y "$EXE" 2>/dev/null)"; then
  # A zero cutoff makes every session look current, which reads as a finished
  # rollout when in fact nothing can be assessed.
  say "cannot stat $EXE; refusing to assess sessions"; exit 1
fi
# Nothing is installed during a dry run, so the real cutoff would be the
# previous install and the preview would under-report. "Now" is what the cutoff
# becomes once a real install lands.
[ "$DRY" -eq 1 ] && bin_mtime="$(date +%s)"

sessions="$(agents_json)" || { say "could not read the session list; deferring"; exit 0; }
if ! printf '%s' "$sessions" | python3 -c "$PY_STALE" "$bin_mtime" > "$STALEFILE" 2>>"$LOG"; then
  say "could not classify the session list; see $LOG"; exit 1
fi
count="$(tr -cd '\0' < "$STALEFILE" | wc -c)"
say "sessions still on the old binary: ${count:-0}"
if [ "${count:-0}" -eq 0 ]; then
  if [ "$DRY" -eq 0 ]; then
    # Clears pending only. A session this tool stopped and could not bring back
    # is not in the live list, so the state file is its only record; PY_STATE
    # removes the file when nothing at all is outstanding.
    python3 -c "$PY_STATE" "$STATE" pending "$new_version"
  fi
  if [ "$(python3 -c "$PY_STATE" "$STATE" count-failed 2>/dev/null || echo 0)" -gt 0 ]; then
    say "no sessions on the old binary, but earlier failures are still recorded"
    exit 1
  fi
  say "rollout complete at $new_version"
  exit 0
fi

if [ "$DRY" -eq 1 ]; then
  tr '\0' '\n' < "$STALEFILE" | tr '\037' ' ' \
    | sed 's/^/    would-restart-when-idle: /' | tee -a "$LOG"
  exit 0
fi

pending=""; failed=""
while IFS=$'\x1f' read -r -d '' id sid cwd name; do
  [ -z "${id:-}" ] && continue
  # Sessions are handled in order, so a busy one holds up those behind it;
  # PASS_DEADLINE bounds the pass as a whole and DEADLINE bounds each wait.
  if (( SECONDS - pass_start > PASS_DEADLINE )); then
    say "  pass deadline reached; leaving $name and any after it for the next run"
    pending="$pending $id"; continue
  fi
  started_at=$SECONDS
  local_deadline=$DEADLINE
  remaining=$(( PASS_DEADLINE - (SECONDS - pass_start) ))
  [ "$remaining" -lt "$local_deadline" ] && local_deadline=$remaining
  streak=0; skip=0
  while :; do
    if [ -e "$INHIBIT" ]; then
      say "  $INHIBIT appeared; leaving $name alone"
      pending="$pending $id"; skip=1; break
    fi
    if (( SECONDS - started_at > local_deadline )); then
      say "  $name ($id): still busy after ${local_deadline}s — leaving it for the next run"
      pending="$pending $id"; skip=1; break
    fi
    st="$(agents_json </dev/null | python3 -c "$PY_STATUS" "$id")" \
      || { say "  $name ($id): session list unreadable; leaving it"; pending="$pending $id"; skip=1; break; }
    case "$st" in
      gone) log "  $name ($id): already gone"; skip=1; break ;;
      idle) streak=$((streak+1)); [ "$streak" -ge "$IDLE_STREAK" ] && break ;;
      *)    streak=0 ;;
    esac
    sleep "$POLL"
  done
  [ "$skip" -eq 1 ] && continue

  say "  $name ($id): idle — restarting onto $new_version"
  if ! restart_possible "$id" "$cwd" "$name" "$sid"; then
    pending="$pending $id"
    continue
  fi
  if ! python3 -c "$PY_STATE" "$STATE" record "$id" "$sid" "$cwd" "$name"; then
    # This record is the only thing that survives the stop; without it a failure
    # later in the restart loses the session silently.
    say "    cannot record $name in $STATE; not stopping it"
    pending="$pending $id"
    continue
  fi
  stop_rc=0
  run_claude stop "$id" >>"$LOG" 2>&1 </dev/null || stop_rc=$?
  # `claude stop` returning 0 means the daemon accepted the stop, not that the
  # session has finished; resuming one that is still running leaves two live
  # copies of the same conversation acting on the same directory.
  gone=unknown
  for _ in $(seq 1 8); do
    if st="$(agents_json </dev/null | python3 -c "$PY_STATUS" "$id" 2>/dev/null)"; then
      [ "$st" = gone ] && { gone=yes; break; }
      gone=no
    else
      gone=unknown
    fi
    sleep 2
  done
  if [ "$gone" != yes ]; then
    # Whether it is winding down slowly or the list was unreadable, the record
    # stays: retry_failed asks whether the session is accounted for before it
    # resumes anything, which is the only safe way to settle this.
    say "    cannot confirm $name stopped (stop exit $stop_rc); leaving it recorded"
    failed="$failed $id"
    continue
  fi

  resume_session "$id" "$sid" "$cwd" "$name"; rrc=$?
  if [ "$rrc" -eq 0 ]; then
    python3 -c "$PY_STATE" "$STATE" drop "$id" >/dev/null
    continue
  fi
  if [ "$rrc" -eq 2 ]; then
    # Running but unidentified: recording it would make the retry start a
    # second agent on the same conversation.
    say "    WARNING: $name came back but could not be identified; its pin was not moved"
    python3 -c "$PY_STATE" "$STATE" drop "$id" >/dev/null
    pending="$pending $id"
    continue
  fi
  # The stop succeeded, so this session is down and the live list will not
  # rediscover it next run.
  say "    ERROR: $name ($id) was stopped but did not come back; see $LOG"
  failed="$failed $id"
done < "$STALEFILE"

pending="${pending# }"; failed="${failed# }"
if [ -n "$failed" ]; then
  say "sessions stopped that did not come back: $failed"
fi
# shellcheck disable=SC2086
python3 -c "$PY_STATE" "$STATE" pending "$new_version" $pending
[ -n "$pending" ] && say "pending rollout recorded for: $pending"

say "rollout pass finished at $new_version"
[ -n "$failed" ] && exit 1
exit 0
