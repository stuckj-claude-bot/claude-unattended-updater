[Unit]
Description=Roll out Claude Code updates once sessions go idle
Documentation=https://github.com/stuckj/claude-unattended-updater

[Service]
Type=oneshot
# Step 4 waits for each session to finish what it is doing, so a run can sit for
# hours by design; the script's own UPDATER_DEADLINE bounds it, not systemd.
TimeoutStartSec=infinity
ExecStart=/usr/bin/claude-unattended-update
SyslogIdentifier=claude-unattended-update
